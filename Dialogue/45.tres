[resource]
script = ExtResource("1_cj70k")
id = "45"
speaker = "Echo"
text = "But listen to me, witnesses, strangers. You know already that what happened here cannot be undone. He will never be mine again in this life. But listen, listen. It still grows warm. Our lands are called sacred less and less, and treated in accordance to the falling reverence. So strangers, know this: the red could come for you too."
vc_file = ExtResource("2_y6jwy")
