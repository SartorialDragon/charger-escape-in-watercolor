script = ExtResource("1_wfte8")
id = "20"
speaker = "Echo"
text = "Red. It was all red. Red, and thick, and choking. I could not see forward, and I could not see him, for he is red, too. As such we were separated. As such everything fell apart."
vc_file = ExtResource("2_rkaxh")
