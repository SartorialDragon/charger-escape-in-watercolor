script = ExtResource("1_tbaj8")
id = "10"
speaker = "Echo"
text = "I was overwhelmed. Too many smells, too many of them too hard to place apart. I saw a rock structure and climbed it on weary legs. There-- his scent. I knew it as well as I knew my own life. What was there to do but follow it?"
vc_file = ExtResource("2_tbaj8")
