script = ExtResource("1_eqsjm")
id = "30"
speaker = "Echo"
text = "It was there, collapsed amongst our fallen lands that I swore I saw him again. So close, and beckoning me. He'd draw me forth even when we were young. 'Run with me,' he'd say, and I would. But my love, I... cannot go so quickly, now. But I'll keep going."
