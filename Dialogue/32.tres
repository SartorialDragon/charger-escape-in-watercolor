script = ExtResource("1_xms17")
id = "32"
speaker = "Echo"
text = "Everything has led me here, but there's nothing left. How much did the red devour? How little do we have now? We used to soak ourselves here and then bask in the sun. Now, even the sun is grey. Oh, my love, where are you?"
vc_file = ExtResource("2_by2nm")
