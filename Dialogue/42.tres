script = ExtResource("1_y7rbb")
id = "42"
speaker = "Echo"
text = "It was then that I saw my love flicker before my eyes. His body was cold against my skin,but the stallion I saw was warm, and familiar. He called out, too. He stood between us. 'I am here no longer,' I heard him utter in my empty heart, 'but you are. So live. Stand, and live.'"
vc_file = ExtResource("2_5prqg")
