script = ExtResource("1_8g6yv")
id = "41"
speaker = "Echo"
text = "There was another herd there. Survivors. Lucky ones. I saw then how much was owed to chance. They called to me, another wayward soul who outlasted the blaze. 'Come with us,' they nickered, but how could I?"
vc_file = ExtResource("2_ciuah")
