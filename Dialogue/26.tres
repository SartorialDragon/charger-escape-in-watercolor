script = ExtResource("1_ovym5")
id = "26"
speaker = "Echo"
text = "Ah! Well, the humans are always leaving rubbish around our wilds. Sometimes they chase us with loud machines. Sometimes they simply pass through, but leave behind their trash. But I can use this."
