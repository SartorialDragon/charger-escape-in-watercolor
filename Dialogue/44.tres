[resource]
script = ExtResource("1_r5t4a")
id = "44"
speaker = "Echo"
text = "They waited for me until the earth started to take my love back, for I could not bring myself to go yet. But I took one step, and then another, and they surrounded me, close and warm. 'Keep moving forward,' one of them told me, 'even though there's no real coming back from this,' So move forward, I did."
vc_file = ExtResource("2_pfhox")
